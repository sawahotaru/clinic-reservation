# Oracle/本番用: clinic-reservation を /clinic-reservation/ サブパスで単体コンテナとして動かす。
# onamaeデプロイ(.github/workflows/deploy.yml)の "Arrange on server" 処理をビルド時に再現する。
# 目的: lab.4510.be/clinic-reservation/ で現行と同じ挙動（baseUrl・管理スラッグ・honeypot）を再現。
# ⚠ FROM は変数展開せず**リテラルで書く**こと。Dependabot は FROM の変数を解釈できず、
#   ARG 経由だと docker の更新PRが一本も来ない（2026-07-29 に実測して判明。同設定の
#   oracle-lab はリテラル記法なので3本届いていた）。PHP_VERSION は compose 側でも
#   8.4 固定で、変数にしている実益が無かったため撤去した。
FROM php:8.5-apache

# 管理画面の秘密スラッグ（偽装工作②）。空なら /admin/ のまま（Basic認証のみ）。
# 値は git 外・GitHub Secrets 外の VM 側 .env から compose 経由で渡す（露出防止）。
ARG ADMIN_SLUG=""

# rewrite/remoteip 有効化 + .htaccess を効かせる(AllowOverride All) + PHPタイムゾーン日本 + curl(保険)
# ※ AllowOverride None のままだと Basic認証/Require denied の .htaccess が無視され重大な穴になる。
# ※ mod_remoteip: リバースプロキシ(Caddy)配下でも REMOTE_ADDR を実クライアントIPに復元する。
#    → clinic の honeypot（REMOTE_ADDR でIP記録/自動ブロック）が「全員=プロキシIP」で自滅するのを防ぐ。
#    PHPコードは変更不要（REMOTE_ADDR の値が正しくなるだけ）。信頼するのは内部/プロキシの私設レンジのみ。
RUN apt-get update && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && a2enmod rewrite remoteip \
 && printf 'RemoteIPHeader X-Forwarded-For\nRemoteIPTrustedProxy 10.0.0.0/8\nRemoteIPTrustedProxy 172.16.0.0/12\nRemoteIPTrustedProxy 192.168.0.0/16\n' > /etc/apache2/conf-available/remoteip.conf \
 && a2enconf remoteip \
 && sed -ri 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf \
 && echo "date.timezone = Asia/Tokyo" > /usr/local/etc/php/conf.d/timezone.ini

# docroot は既定の /var/www/html のまま。clinic は /clinic-reservation/ 配下に置く。
# → URL /clinic-reservation/ = onamaeの docroot 直下と同じ相対構成になり、includeも一致する。
WORKDIR /var/www/html/clinic-reservation

# ソース配置（onamaeの「public 直下が docroot、その下に src/」を再現）
COPY public/ ./
COPY src/ ./src/
COPY scripts/ ./scripts/
# holidays.csv はデータ扱いだが初期シードとして退避（volume が空なら entrypoint が配置）
COPY data/holidays.csv /opt/seed/holidays.csv

# PHPMailer（Gmail SMTP送信）をビルド時に取得（onamaeデプロイと同じ）
RUN bash ./scripts/fetch-phpmailer.sh

# 非公開ディレクトリ拒否 + 管理画面スラッグ移設 + includeパス正規化（deploy.yml の Arrange 相当）
RUN set -eux; \
    printf 'Require all denied\n' > src/.htaccess; \
    mkdir -p data; printf 'Require all denied\n' > data/.htaccess; \
    SLUG="${ADMIN_SLUG}"; \
    if [ -n "$SLUG" ]; then \
      echo "$SLUG" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$' || { echo "FATAL: invalid ADMIN_SLUG"; exit 1; }; \
      case "$SLUG" in src|data|admin|assets|api|index.php|wp-admin|administrator|phpmyadmin) \
        echo "FATAL: ADMIN_SLUG is a reserved name"; exit 1;; esac; \
      rm -rf "./$SLUG"; mv admin "./$SLUG"; ADMIN_DIR="$SLUG"; \
      echo "admin relocated to secret slug"; \
    else \
      ADMIN_DIR="admin"; echo "ADMIN_SLUG unset -> admin stays at /admin/ (Basic auth only)"; \
    fi; \
    printf 'AuthType Basic\nAuthName "Clinic Admin (staff only)"\nAuthUserFile /var/www/html/clinic-reservation/data/.htpasswd\nRequire valid-user\n' > "$ADMIN_DIR/.htaccess"; \
    find . -name '*.php' -not -path './src/*' -print0 | xargs -0 -r sed -i 's#/\.\./src/#/src/#g'; \
    rm -rf ./scripts; \
    echo "clinic arranged (admin dir: $ADMIN_DIR)"

# リマインダーのCLI。⚠ 上の Arrange より**後**に置くこと。
# Arrange の include パス正規化（'/../src/' → '/src/'）が bin/*.php にも当たってしまい、
# bin から見た src の位置（../src）を壊すため。
# この配置では docroot 直下＝この階層なので、Web からも見えてしまう。二重に塞ぐ:
#   ① .htaccess で拒否  ② スクリプト自身が PHP_SAPI !== 'cli' なら 404 で即終了
COPY bin/ ./bin/
RUN printf 'Require all denied\n' > bin/.htaccess

# data/ は起動時に www-data 所有へ（SQLite/.htpasswd/log/holidays を置く永続ボリューム）
COPY docker/oracle-entrypoint.sh /usr/local/bin/oracle-entrypoint.sh
RUN chmod +x /usr/local/bin/oracle-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/oracle-entrypoint.sh"]
